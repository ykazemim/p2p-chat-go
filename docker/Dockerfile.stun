FROM golang:1.23-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o stun-server ./cmd/stun-server

FROM alpine:3.19
RUN apk --no-cache add ca-certificates
WORKDIR /app
COPY --from=builder /app/stun-server .

EXPOSE 8080
CMD ["./stun-server", "-addr", ":8080", "-redis", "redis:6379"]
